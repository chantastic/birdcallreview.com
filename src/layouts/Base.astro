---
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../lib/episodes';

interface Props {
  title?: string;
  description?: string;
  canonicalPath: string;
}

const { title, description = SITE_DESCRIPTION, canonicalPath } = Astro.props;
const pageTitle = title ?? SITE_TITLE;
const canonical = `${SITE_URL}${canonicalPath}`;
---

<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/css/main.css" />
    <link href="https://fonts.googleapis.com/css?family=Lato|Vollkorn" rel="stylesheet" type="text/css" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={`${SITE_URL}/feed.xml`} />
  </head>
  <body class="btc-red bw-0 bs-s ff-normal" style="border-top-width: 8px">
    <slot />
    <script is:inline>
      (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
      (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
      m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
      })(window,document,'script','//www.google-analytics.com/analytics.js','ga');

      ga('create', 'UA-74078597-1', 'auto');
      ga('send', 'pageview');
    </script>
  </body>
</html>
