---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EpisodeList from '../components/EpisodeList.astro';
import { episodesForPage, loadEpisodes } from '../lib/episodes';

const episodes = await loadEpisodes();
const pageEpisodes = episodesForPage(episodes, 1);
---

<Base canonicalPath="/">
  <Header />
  <div class="page-content">
    <div class="wrapper">
      <EpisodeList episodes={pageEpisodes} page={1} total={episodes.length} />
    </div>
  </div>
  <Footer />
</Base>
