---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Credits" canonicalPath="/credits">
  <Header />
  <div class="page-content">
    <div class="wrapper">
      <div class="bs-s bw-0 btw-1p bc-l.8 pt-3">
        <a href="/" class="fs-24p c-grey">Home</a> <span class="c-grey">&raquo;</span> <h2 class="c-red ff-bold fs-24p d-ib" style="letter-spacing: 0" itemprop="name headline">Credits</h2>
        <ul class="mb-2">
          <li>Bird call samples from the <a href="http://www.birds.cornell.edu/" class="c-red">Cornell Lab of Ornithology</a>.</li>
          <li>Artwork by Matt Steele, Hernan D. Schlosman, and Leadway Global LLC from the <a href="https://thenounproject.com/" class="c-red">Noun Project</a>.</li>
          <li>Episode bird photos from <a href="https://www.wikipedia.org/" class="c-red">Wikipedia</a>.</li>
          <li><a href="https://github.com/chantastic/birdcallreview.com" class="c-red">Version control</a> on <a href="https://github.com" class="c-red">GitHub</a>.</li>
          <li>Website built with <a href="https://astro.build/" class="c-red">Astro</a> on <a href="https://developers.cloudflare.com/workers/" class="c-red">Cloudflare Workers</a>. Audio on <a href="https://developers.cloudflare.com/r2/" class="c-red">R2</a>.</li>
          <li>Recorded on <a href="http://www.apple.com/mac/garageband/" class="c-red">Garage Band</a> with music generated by bundled samples.</li>
        </ul>
      </div>
    </div>
  </div>
  <Footer />
</Base>
