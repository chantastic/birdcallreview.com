---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { displayDate, loadEpisodes } from '../../lib/episodes';

const episodes = await loadEpisodes();
const ordered = [...episodes].sort((a, b) => a.data.date.localeCompare(b.data.date));
const first = displayDate(ordered[0].data.date);
const last = displayDate(ordered[ordered.length - 1].data.date);
---

<Base title="About" canonicalPath="/about/">
  <Header />
  <div class="page-content">
    <div class="wrapper">
      <article class="post">
        <header class="post-header">
          <h1 class="post-title">About</h1>
        </header>
        <div class="post-content">
          <p>Bird calls are incredibly diverse. But are they all good? Are some just okay? Can a bird call be sexy? Let's find out.</p>
          <p>Jeremy Ricketts &amp; Michael Chan. {episodes.length} episodes, from {first} through {last}.</p>
        </div>
      </article>
    </div>
  </div>
  <Footer />
</Base>
