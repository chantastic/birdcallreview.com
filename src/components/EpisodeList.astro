---
import {
  playbackUrl,
  displayDate,
  episodeHtml,
  pageCount,
  pageHref,
  type Episode,
} from '../lib/episodes';

interface Props {
  episodes: Episode[];
  page: number;
  total: number;
}

const { episodes, page, total } = Astro.props;
const pages = pageCount(total);
---

<div class="home bs-s bw-0 btw-1p bc-l.8">
  <ul class="post-list">
    {
      episodes.map((episode) => (
        <li class="p-1 pt-3 bs-s bw-0 bbw-1p bc-l.8">
          <span class="post-meta">{displayDate(episode.data.date)}</span>
          <h2>
            <a class="post-link c-red ff-bold" href={`/${episode.id}`}>{episode.data.title}</a>
          </h2>
          <div class="ff-sans" set:html={episodeHtml(episode.body)} />
          <audio src={playbackUrl(episode.data.audio)} class="w-100%" controls="controls" preload="metadata">
            Your browser does not support the <code>audio</code> element.
          </audio>
        </li>
      ))
    }
  </ul>
  <div class="ta-c">
    <p>You're on page {page} of {pages}</p>
    <p class="px_1 py_.5">
      {page > 1 && <a href={pageHref(page - 1)} class="c-red ff-bold bc-lightgrey bs-s bw-1p bs-3p d-ib">&laquo; Newer Shows</a>}
      {page < pages && <a href={pageHref(page + 1)} class="c-red ff-bold bc-lightgrey bs-s bw-1p bs-3p d-ib">Older Shows &raquo;</a>}
    </p>
  </div>
</div>
