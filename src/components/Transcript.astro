---
import type { TranscriptTurn } from '../lib/transcript';

interface Props {
  turns: TranscriptTurn[];
}

const { turns } = Astro.props;
---

<details class="transcript" id="transcript">
  <summary>Transcript</summary>
  <p class="copy-status visually-hidden" aria-live="polite"></p>
  <p class="transcript-note">Each time opens that moment. Copy link keeps a URL you can share.</p>
  <ol class="transcript-turns">
    {
      turns.map((turn) => (
        <li
          class:list={['transcript-turn', turn.continued && 'is-continued']}
          data-start={turn.seconds}
          data-speaker={turn.slot}
          id={turn.id}
        >
          <a class="transcript-time" href={`#t=${turn.hash}`}>
            <span class="visually-hidden">Play from </span>
            {turn.label}
          </a>
          <span class="transcript-speaker">{turn.speaker}</span>
          <button type="button" class="transcript-copy" data-seconds={turn.seconds} aria-label={`Copy link to ${turn.label}`}>
            Copy link
          </button>
          <p class="transcript-text">{turn.text}</p>
        </li>
      ))
    }
  </ol>
</details>
