{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "birdcallreview",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "build": {
    "command": "npm run build"
  }
}
