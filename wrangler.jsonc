{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "birdcallreview",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  },
  "build": {
    "command": "npm run build"
  }
}
